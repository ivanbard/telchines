{
  "schema_version": "0.1",
  "name": "openai",
  "providers": [
    {
      "name": "openai",
      "kind": "openai_compatible",
      "capabilities": ["repair", "generation"],
      "base_url_env": "TELCHINES_OPENAI_BASE_URL",
      "base_url_default": "https://api.openai.com/v1",
      "endpoint": "chat/completions",
      "model_env": "TELCHINES_OPENAI_MODEL",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_seconds": 90,
      "enabled_env": "TELCHINES_LIVE_OPENAI",
      "live": true,
      "supports": {"repair": true, "generation": true, "shell": true}
    },
    {
      "name": "openai-agent",
      "kind": "agent_runtime",
      "capabilities": ["repair"],
      "base_provider": "openai",
      "runtime": "langgraph",
      "max_iterations": 3,
      "timeout_seconds": 90,
      "enabled_env": "TELCHINES_LIVE_OPENAI",
      "live": true,
      "supports": {"repair": true, "generation": false, "shell": true}
    }
  ]
}
