{
  "schema_version": "0.1",
  "name": "anthropic",
  "providers": [
    {
      "name": "anthropic",
      "kind": "anthropic",
      "capabilities": ["repair", "generation"],
      "base_url_env": "TELCHINES_ANTHROPIC_BASE_URL",
      "base_url_default": "https://api.anthropic.com/v1",
      "endpoint": "messages",
      "model_env": "TELCHINES_ANTHROPIC_MODEL",
      "model_default": "claude-3-5-sonnet-latest",
      "api_key_env": "ANTHROPIC_API_KEY",
      "anthropic_version": "2023-06-01",
      "max_tokens": 4096,
      "timeout_seconds": 90,
      "enabled_env": "TELCHINES_LIVE_ANTHROPIC",
      "live": true,
      "supports": {"repair": true, "generation": true, "shell": true}
    },
    {
      "name": "anthropic-agent",
      "kind": "agent_runtime",
      "capabilities": ["repair"],
      "base_provider": "anthropic",
      "runtime": "langgraph",
      "max_iterations": 3,
      "timeout_seconds": 90,
      "enabled_env": "TELCHINES_LIVE_ANTHROPIC",
      "live": true,
      "supports": {"repair": true, "generation": false, "shell": true}
    }
  ]
}
