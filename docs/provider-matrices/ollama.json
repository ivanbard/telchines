{
  "schema_version": "0.1",
  "name": "ollama",
  "providers": [
    {
      "name": "ollama-local",
      "kind": "openai_compatible",
      "capabilities": ["repair", "generation"],
      "base_url_env": "TELCHINES_LOCAL_OPENAI_BASE_URL",
      "base_url_default": "http://127.0.0.1:11434/v1",
      "endpoint": "chat/completions",
      "model_env": "TELCHINES_LOCAL_OPENAI_MODEL",
      "model_default": "qwen2.5-coder",
      "api_key_env": "TELCHINES_LOCAL_OPENAI_API_KEY",
      "timeout_seconds": 120,
      "enabled_env": "TELCHINES_LIVE_LOCAL_OPENAI",
      "live": true,
      "supports": {"repair": true, "generation": true, "shell": true}
    }
  ]
}
